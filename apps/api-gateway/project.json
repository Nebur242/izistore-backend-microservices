{
  "name": "api-gateway",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api-gateway/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack --config apps/api-gateway/webpack.config.js && cp apps/api-gateway/Dockerfile dist/apps/api-gateway/Dockerfile",
        "args": [],
        "assets": []
      },
      "configurations": {
        "development": {
          "command": "webpack --config apps/api-gateway/webpack.config.js --mode development"
        },
        "production": {
          "command": "webpack --config apps/api-gateway/webpack.config.js --mode production && cp apps/api-gateway/Dockerfile dist/apps/api-gateway/Dockerfile"
        }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "api-gateway:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "api-gateway:build:development"
        },
        "production": {
          "buildTarget": "api-gateway:build:production"
        }
      }
    }
  }
}
